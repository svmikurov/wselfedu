# Config to load fixtures into database
# Version 0.1.4 (2026-02-23)

load_order:
  # Public
  - db/fixtures/public/core.json
  # Sensitive
  - db/fixtures/sensitive/users.json
  - db/fixtures/sensitive/core.json
  - db/fixtures/sensitive/glossary.json
  - db/fixtures/sensitive/lang.json
  - db/fixtures/sensitive/math.json
  - db/fixtures/sensitive/study.json

options:
  default_database: "default"
  ignore_nonexistent: false